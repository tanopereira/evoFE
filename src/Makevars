CXX_STD = CXX17
UNAME_S := $(shell uname -s)
override CXXFLAGS := -O3 -mcpu=native -mtune=native -ffp-contract=fast -funroll-loops -fno-math-errno -fno-trapping-math -DNDEBUG
override CXX17FLAGS := -O3 -mcpu=native -mtune=native -ffp-contract=fast -funroll-loops -fno-math-errno -fno-trapping-math -DNDEBUG
ifeq ($(UNAME_S),Darwin)
PKG_CXXFLAGS = -O3 -mcpu=native -mtune=native -ffp-contract=fast -funroll-loops -fno-math-errno -fno-trapping-math -DNDEBUG -DACCELERATE_NEW_LAPACK -DEIGEN_NO_DEBUG -DEIGEN_PERMANENTLY_DISABLE_STUPID_WARNINGS -DEIGEN_USE_BLAS $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) -framework Accelerate
else
PKG_CXXFLAGS = -O3 -mcpu=native -mtune=native -ffp-contract=fast -funroll-loops -fno-math-errno -fno-trapping-math -DNDEBUG -DEIGEN_NO_DEBUG -DEIGEN_PERMANENTLY_DISABLE_STUPID_WARNINGS -DEIGEN_USE_BLAS $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS)
endif
