CXX_STD = CXX17
override CXXFLAGS := -O3 -mcpu=native -mtune=native -ffp-contract=fast -funroll-loops -DNDEBUG
override CXX17FLAGS := -O3 -mcpu=native -mtune=native -ffp-contract=fast -funroll-loops -DNDEBUG
PKG_CXXFLAGS = -O3 -mcpu=native -mtune=native -ffp-contract=fast -funroll-loops -DNDEBUG -DEIGEN_NO_DEBUG -DEIGEN_PERMANENTLY_DISABLE_STUPID_WARNINGS -DEIGEN_USE_BLAS $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS)
